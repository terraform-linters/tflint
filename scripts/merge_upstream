#!/bin/bash

UPSTREAM=upstream

if (( $# != 1 )); then
    >&2 echo "Syntax: $0 <tag>"
    exit 1
fi

TAG=$1

#Check that git exists
if ! command -v git &> /dev/null
then
    echo "git could not be found"
    exit 1
fi

#Check that grep exists
if ! command -v grep &> /dev/null
then
    echo "grep could not be found"
    exit 1
fi


#Check if upstream exists
if ! git remote | grep ${UPSTREAM} &> /dev/null; then
    echo "Adding ${UPSTREAM} repo"
    git remote add ${UPSTREAM} https://github.com/terraform-linters/tflint.git
fi

if ! git remote | grep ${UPSTREAM} &> /dev/null; then
    echo "Upstram repo is not available and cannot be added"
    exit 1
fi

echo "Fetching ${UPSTREAM} tag ${TAG}"
TAG_REF="refs/tags/upstream/${TAG}"
if ! git fetch ${UPSTREAM} "refs/tags/${TAG}:${TAG_REF}"; then
    echo "Cannot fetch tag ${TAG} from ${UPSTREAM}"
    exit 1
fi

echo "Fetching origin"
if ! git fetch origin master; then
    echo "Could not fetch origin/master"
    exit 1
fi

BRANCH="sync-upstream-${TAG}"
echo "Checking out sync branch ${BRANCH} from origin/master"
if ! git checkout -B "${BRANCH}" origin/master; then
    echo "Could not checkout branch ${BRANCH}"
    exit 1
fi

echo "Merging upstream tag ${TAG} without committing"
git merge --no-commit --no-ff "${TAG_REF}" || true

echo "Restoring fork workflows from origin/master"
git reset origin/master -- .github/workflows
git checkout origin/master -- .github/workflows
git clean -fd .github/workflows

if git diff --name-only --diff-filter=U | grep -q .; then
    echo "Merge conflicts detected outside of .github/workflows:"
    git diff --name-only --diff-filter=U
    exit 1
fi

echo "Setting version in snapcraft.yaml"
if ! sed "s/VERSION/${TAG}/g" snap/snapcraft.yaml.template > snap/snapcraft.yaml; then
    echo "Could not set version of snapcraft.yaml"
    exit 1
fi
git add snap/snapcraft.yaml

if ! git commit -m "Merging upstream tag ${TAG}"; then
    echo "Could not commit merge"
    exit 1
fi

echo "Pushing ${BRANCH} to origin"
if ! git push -u origin "${BRANCH}"; then
    echo "Cannot push ${BRANCH} to origin"
    exit 1
fi

echo ""
echo "Branch ${BRANCH} pushed successfully!"
echo "Because 'master' requires the 'snapcraft-pack' status check, changes must be merged via Pull Request."

if command -v gh &> /dev/null; then
    echo "Checking for existing pull request..."
    existing_pr="$(gh pr list -R tingdahl/tflint --head "${BRANCH}" --base master --json number --jq '.[0].number' 2>/dev/null || true)"
    if [[ -n "${existing_pr}" ]]; then
        echo "Pull request already exists: https://github.com/tingdahl/tflint/pull/${existing_pr}"
    else
        echo "Creating pull request..."
        gh pr create -R tingdahl/tflint \
            --base master \
            --head "${BRANCH}" \
            --title "Merge upstream tag ${TAG}" \
            --body "Automated sync for upstream release tag ${TAG}." || true
    fi
else
    echo "Create a PR from ${BRANCH} -> master on GitHub to run snapcraft-pack and merge into master."
fi

echo "Merge branch completed"

